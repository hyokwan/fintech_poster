# 복사해서 .env 로 저장하고 값을 채우세요. 비워두면 기본값을 씁니다.

# 서버 주소. 여러 사람이 접속하는 서버라면 HOST=0.0.0.0
PORT=3001
HOST=127.0.0.1

# 외부에서 접속하는 주소 (네이버 로그인 콜백 주소를 만들 때 씀). 비우면 접속한 주소를 그대로 씀
# PUBLIC_URL=https://studio.example.ac.kr

# DB: 비워두면 data/studio.db (SQLite)를 씁니다. MariaDB/MySQL을 쓰려면 아래를 채우세요.
# DB_HOST=
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=creator_studio

# https 로 서비스한다면 1 (로그인 쿠키에 Secure 를 붙임)
# COOKIE_SECURE=1
